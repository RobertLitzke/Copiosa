<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup / device-transfer rules for Android 12+ (android:dataExtractionRules). Only excludes
    are listed, so everything else is still included. See backup_rules.xml for why secure_keys.xml
    (the encrypted API-key store) is left out: its keystore master key does not travel with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_keys.xml" />
    </device-transfer>
</data-extraction-rules>
